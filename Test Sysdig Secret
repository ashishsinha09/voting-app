name: Test Sysdig Secret
on: workflow_dispatch
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Check token
        env:
          TOKEN: ${{ secrets.SYSDIG_TOKEN }}
        run: |
          if [ -z "$TOKEN" ]; then
            echo "::error::SYSDIG_TOKEN is EMPTY"
            exit 1
          else
            echo "Token is SET (length: ${#TOKEN} chars)"
          fi
      - name: Check URL
        env:
          URL: ${{ secrets.SYSDIG_SECURE_URL }}
        run: |
          if [ -z "$URL" ]; then
            echo "::error::SYSDIG_SECURE_URL is EMPTY"
            exit 1
          else
            echo "URL is SET: $URL"
          fi
