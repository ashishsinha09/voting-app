name: Sysdig Container Image Scan
on:
  # ── Scan every PR targeting main or develop ──────────────────────────────
  pull_request:
    branches:
      - main
      - master
      - develop
    paths:
      - 'Dockerfile*'
      - '**/*.dockerfile'
      - 'src/**'
      - '.github/workflows/sysdig-container-scan.yml'

  # ── Scan on every push to main (post-merge gate) ─────────────────────────
  push:
    branches:
      - main
      - master

  # ── Reusable: call this workflow from another pipeline after docker build ─
  workflow_call:
    inputs:
      image-ref:
        description: 'Fully qualified image reference to scan (e.g. myapp:sha-abc123)'
        required: false
        type: string
      dockerfile-path:
        description: 'Path to Dockerfile (default: ./Dockerfile)'
        required: false
        type: string
        default: './Dockerfile'
      fail-on-severity:
        description: 'Minimum severity to fail the build: critical | high | medium | low'
        required: false
        type: string
        default: 'high'
    secrets:
      SYSDIG_SECURE_TOKEN:
        required: true
      SYSDIG_SECURE_URL:
        required: true

# Cancel in-flight scans for the same PR when a new commit is pushed
concurrency:
  group: sysdig-scan-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

# Minimal permissions — only what the scan needs
permissions:
  contents: read
  security-events: write     # upload SARIF to GitHub Security tab
  pull-requests: write       # post PR comment with scan summary
  packages: read             # read container registry (if private)
  id-token: write            # OIDC token for Sysdig auth (optional)

# ── Environment variables shared across all jobs ────────────────────────────
env:
  # Image name — override with inputs.image-ref when called via workflow_call
  IMAGE_NAME: ${{ inputs.image-ref || format('{0}:{1}', github.repository, github.sha) }}
  DOCKERFILE: ${{ inputs.dockerfile-path || './Dockerfile' }}
  FAIL_ON_SEVERITY: ${{ inputs.fail-on-severity || 'high' }}
  REGISTRY: ghcr.io

jobs:
  # ════════════════════════════════════════════════════════════════════════════
  # JOB 1: BUILD — Build the Docker image and export it as a tarball
  # ════════════════════════════════════════════════════════════════════════════
  build:
    name: 🐳 Build Image
    runs-on: ubuntu-latest
    outputs:
      image-ref: ${{ steps.meta.outputs.tags }}
      image-digest: ${{ steps.build.outputs.digest }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0   # full history for accurate diff in PR scans

      # ── Docker Buildx setup ───────────────────────────────────────────────
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # ── Image metadata (tags + labels) ────────────────────────────────────
      - name: Extract image metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ github.repository }}
          tags: |
            type=sha,prefix=sha-,format=short
            type=ref,event=branch
            type=ref,event=pr
            type=semver,pattern={{version}}
            type=raw,value=latest,enable=${{ github.ref == 'refs/heads/main' }}

      # ── Build (no push — scan local image before pushing) ─────────────────
      - name: Build Docker image
        id: build
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ${{ env.DOCKERFILE }}
          push: false
          load: true          # load into local Docker daemon for scanning
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          provenance: true
          sbom: true          # generate SBOM alongside the image

      # ── Save image tar for the scan job ───────────────────────────────────
      - name: Save image as tarball
        run: |
          IMAGE_TAG=$(echo "${{ steps.meta.outputs.tags }}" | head -1)
          echo "IMAGE_TAG=$IMAGE_TAG" >> $GITHUB_ENV
          docker save "$IMAGE_TAG" -o /tmp/image.tar

      - name: Upload image artifact
        uses: actions/upload-artifact@v4
        with:
          name: container-image-${{ github.sha }}
          path: /tmp/image.tar
          retention-days: 1   # only needed for the scan job

  # ════════════════════════════════════════════════════════════════════════════
  # JOB 2: SCAN — Run Sysdig vulnerability + policy scan
  # ════════════════════════════════════════════════════════════════════════════
  scan:
    name: 🔍 Sysdig Image Scan
    runs-on: ubuntu-latest
    needs: build

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # ── Load the image from the build job artifact ─────────────────────────
      - name: Download image artifact
        uses: actions/download-artifact@v4
        with:
          name: container-image-${{ github.sha }}
          path: /tmp

      - name: Load Docker image
        run: |
          docker load -i /tmp/image.tar
          # Export the first tag for the scan step
          IMAGE_TAG=$(docker images --format "{{.Repository}}:{{.Tag}}" | grep -v "<none>" | head -1)
          echo "SCAN_IMAGE=$IMAGE_TAG" >> $GITHUB_ENV
          echo "Scanning image: $IMAGE_TAG"

      # ── Sysdig CLI scanner ─────────────────────────────────────────────────
      - name: Sysdig Secure — Container Image Scan
        id: sysdig-scan
        uses: sysdig/scan-action@v5
        with:
          # Image to scan
          image-ref: ${{ env.SCAN_IMAGE }}

          # Authentication
          sysdig-secure-token: ${{ secrets.SYSDIG_SECURE_TOKEN }}
          sysdig-secure-url: ${{ secrets.SYSDIG_SECURE_URL }}

          # Output — SARIF for GitHub Security tab + JSON for PR comment
          format: sarif
          output-file: sysdig-scan-results.sarif

          # Policy evaluation
          # Set to true to fail the build when policy evaluation fails
          stop-on-failed-policy-eval: true

          # Fail on vulnerabilities of this severity or higher
          # Values: critical | high | medium | low | negligible
          severity-at-least: ${{ env.FAIL_ON_SEVERITY }}

          # Include packages without vulnerabilities in the report
          list-packages-as-full: false

          # Skip TLS verification (only for self-hosted Sysdig instances)
          sysdig-skip-tls: false

          # Override the default pull policy
          pull-policy: always

        # Continue even if the scan fails so we can always upload the report
        continue-on-error: true

      # ── Upload SARIF to GitHub Security tab ───────────────────────────────
      - name: Upload SARIF to GitHub Security
        uses: github/codeql-action/upload-sarif@v3
        if: always()   # upload even when the scan step fails
        with:
          sarif_file: sysdig-scan-results.sarif
          category: sysdig-container-scan
        continue-on-error: true   # don't fail if GitHub Advanced Security is disabled

      # ── Upload raw SARIF as downloadable artifact ──────────────────────────
      - name: Upload scan results artifact
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: sysdig-scan-results-${{ github.sha }}
          path: sysdig-scan-results.sarif
          retention-days: 30

      # ── Post PR comment with scan summary ────────────────────────────────
      - name: Post PR comment
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const fs = require('fs');
            const scanOutcome = '${{ steps.sysdig-scan.outcome }}';
            const sha = context.sha.slice(0, 7);
            const imageRef = process.env.SCAN_IMAGE || 'unknown';

            // Parse SARIF for a quick summary
            let critCount = 0, highCount = 0, medCount = 0, lowCount = 0, total = 0;
            try {
              const sarif = JSON.parse(fs.readFileSync('sysdig-scan-results.sarif', 'utf8'));
              sarif.runs?.forEach(run => {
                run.results?.forEach(result => {
                  total++;
                  const sev = result.properties?.['problem.severity'] ||
                              result.level ||
                              result.properties?.severity || 'unknown';
                  if (/critical/i.test(sev))   critCount++;
                  else if (/error|high/i.test(sev))    highCount++;
                  else if (/warning|medium/i.test(sev)) medCount++;
                  else                          lowCount++;
                });
              });
            } catch(e) { /* SARIF not parseable — show generic message */ }

            const statusIcon  = scanOutcome === 'success' ? '✅' : '❌';
            const statusLabel = scanOutcome === 'success' ? 'PASSED' : 'FAILED';

            const body = [
              `## ${statusIcon} Sysdig Container Scan — ${statusLabel}`,
              ``,
              `**Image:** \`${imageRef}\`  **Commit:** \`${sha}\``,
              ``,
              `| Severity | Count |`,
              `|----------|-------|`,
              `| 🔴 Critical | ${critCount} |`,
              `| 🟠 High     | ${highCount} |`,
              `| 🟡 Medium   | ${medCount} |`,
              `| 🔵 Low      | ${lowCount} |`,
              `| **Total**   | **${total}** |`,
              ``,
              `📋 **[View full report in GitHub Security tab →](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/security/code-scanning)**`,
              ``,
              `> Scan powered by [Sysdig Secure](https://sysdig.com/products/secure/) · [Documentation](https://docs.sysdig.com/en/docs/sysdig-secure/scanning/)`,
            ].join('\n');

            // Find and update existing comment, or create a new one
            const { data: comments } = await github.rest.issues.listComments({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
            });
            const existing = comments.find(c =>
              c.user.type === 'Bot' && c.body.includes('Sysdig Container Scan')
            );
            if (existing) {
              await github.rest.issues.updateComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                comment_id: existing.id,
                body,
              });
            } else {
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
                body,
              });
            }

      # ── Fail the workflow if the scan detected issues ─────────────────────
      - name: Evaluate scan result
        if: steps.sysdig-scan.outcome == 'failure'
        run: |
          echo "::error::Sysdig scan failed — vulnerabilities at or above '${{ env.FAIL_ON_SEVERITY }}' severity were found."
          echo "::error::Review the Security tab or the uploaded SARIF artifact for details."
          exit 1

  # ════════════════════════════════════════════════════════════════════════════
  # JOB 3: PUSH — Push image to registry ONLY after a clean scan (main branch)
  # ════════════════════════════════════════════════════════════════════════════
  push-image:
    name: 📦 Push to Registry
    runs-on: ubuntu-latest
    needs: [build, scan]
    if: |
      github.event_name == 'push' &&
      (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master')

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract image metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ github.repository }}
          tags: |
            type=sha,prefix=sha-,format=short
            type=raw,value=latest

      # Build AND push — only runs after a successful scan
      - name: Build and push verified image
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ${{ env.DOCKERFILE }}
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          provenance: true
          sbom: true
