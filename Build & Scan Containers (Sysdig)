name: Build and Scan Voting App

on:
  push:
    branches:
      - main
      - master

  pull_request:

jobs:
  scan-images:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Source
        uses: actions/checkout@v4

      # -----------------------------
      # Build Vote Service
      # -----------------------------
      - name: Build Vote Image
        run: |
          docker build -t vote:latest ./vote

      # -----------------------------
      # Build Result Service
      # -----------------------------
      - name: Build Result Image
        run: |
          docker build -t result:latest ./result

      # -----------------------------
      # Build Worker Service
      # -----------------------------
      - name: Build Worker Image
        run: |
          docker build -t worker:latest ./worker

      # -----------------------------
      # Scan Vote Image
      # -----------------------------
      - name: Scan Vote Image
        uses: sysdiglabs/scan-action@v6
        with:
          image-tag: "vote:latest"
          sysdig-secure-token: ${{ secrets.SYSDIG_SECURE_TOKEN }}
          sysdig-secure-url: ${{ secrets.SYSDIG_SECURE_URL }}
          stop-on-failed-policy-eval: true
          stop-on-processing-error: true
          severity-threshold: high

      # -----------------------------
      # Scan Result Image
      # -----------------------------
      - name: Scan Result Image
        uses: sysdiglabs/scan-action@v6
        with:
          image-tag: "result:latest"
          sysdig-secure-token: ${{ secrets.SYSDIG_SECURE_TOKEN }}
          sysdig-secure-url: ${{ secrets.SYSDIG_SECURE_URL }}
          stop-on-failed-policy-eval: true
          stop-on-processing-error: true
          severity-threshold: high

      # -----------------------------
      # Scan Worker Image
      # -----------------------------
      - name: Scan Worker Image
        uses: sysdiglabs/scan-action@v6
        with:
          image-tag: "worker:latest"
          sysdig-secure-token: ${{ secrets.SYSDIG_SECURE_TOKEN }}
          sysdig-secure-url: ${{ secrets.SYSDIG_SECURE_URL }}
          stop-on-failed-policy-eval: true
          stop-on-processing-error: true
          severity-threshold: high
