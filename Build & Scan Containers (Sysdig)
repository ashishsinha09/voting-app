name: Build & Scan Containers (Sysdig)
on:
  # ── Scan every PR targeting main or develop ──────────────────────────────
  pull_request:
    branches:
      - main
      - master
      - develop
    paths:
      - 'vote/**'
      - 'worker/**'
      - 'result/**'
      - '.github/workflows/build-and-scan.yml'

  # ── Scan on every push to main (post-merge gate) ─────────────────────────
  push:
    branches:
      - main
      - master

  # ── Reusable: call from another pipeline ──────────────────────────────────
  workflow_call:
    inputs:
      fail-on-severity:
        description: 'Minimum severity to fail: critical | high | medium | low'
        required: false
        type: string
        default: 'high'
    secrets:
      SYSDIG_TOKEN:
        required: true
      SYSDIG_SECURE_URL:
        required: true

# Cancel in-flight scans for the same PR when a new commit is pushed
concurrency:
  group: sysdig-scan-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  security-events: write       # upload SARIF to GitHub Security tab
  pull-requests: write         # post PR comment with scan summary
  packages: write              # push images to GHCR
  id-token: write              # OIDC token for Sysdig auth (optional)

env:
  REGISTRY: ghcr.io
  FAIL_ON_SEVERITY: ${{ inputs.fail-on-severity || 'high' }}

jobs:
  # ════════════════════════════════════════════════════════════════════════════
  # JOB 1: BUILD & SCAN — one per service via matrix (runs in parallel)
  # ════════════════════════════════════════════════════════════════════════════
  build-scan:
    name: "🐳 Build & Scan — ${{ matrix.service }}"
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false           # don't cancel other services if one fails
      matrix:
        service: [vote, worker, result]

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # ── Docker Buildx ────────────────────────────────────────────────────
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # ── GHCR Login ───────────────────────────────────────────────────────
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # ── Build (load locally — no push yet) ───────────────────────────────
      - name: Build ${{ matrix.service }} image
        id: build
        uses: docker/build-push-action@v6
        with:
          context: ./${{ matrix.service }}
          file: ./${{ matrix.service }}/Dockerfile
          push: false
          load: true
          tags: |
            ${{ env.REGISTRY }}/${{ github.repository }}/${{ matrix.service }}:sha-${{ github.sha }}
            ${{ env.REGISTRY }}/${{ github.repository }}/${{ matrix.service }}:latest
          cache-from: type=gha,scope=${{ matrix.service }}
          cache-to: type=gha,scope=${{ matrix.service }},mode=max

      # ── Sysdig CLI Scanner ───────────────────────────────────────────────
      #
      # FIX 1: "image-tag" not "image-ref" (v6 parameter name)
      # FIX 2: "id: scan" not "id:scan" (space after colon)
      # FIX 3: secrets.SYSDIG_TOKEN (matches your actual GitHub secret name)
      # FIX 4: Removed format/output-file (not valid v6 inputs)
      #        SARIF is auto-generated at ${{ github.workspace }}/sarif.json
      #
      - name: Sysdig Secure — Scan ${{ matrix.service }}
        id: scan
        uses: sysdiglabs/scan-action@v6
        with:
          image-tag: ${{ env.REGISTRY }}/${{ github.repository }}/${{ matrix.service }}:sha-${{ github.sha }}
          sysdig-secure-token: ${{ secrets.SYSDIG_TOKEN }}
          sysdig-secure-url: ${{ secrets.SYSDIG_SECURE_URL }}
          stop-on-failed-policy-eval: true
          stop-on-processing-error: true
          severity-at-least: ${{ env.FAIL_ON_SEVERITY }}
          sysdig-skip-tls: false
        continue-on-error: true

      # ── Upload SARIF to GitHub Security tab ──────────────────────────────
      # FIX 5: path is sarif.json (not sysdig-scan-results.sarif)
      - name: Upload SARIF to GitHub Security
        uses: github/codeql-action/upload-sarif@v3
        if: success() || failure()
        with:
          sarif_file: ${{ github.workspace }}/sarif.json
          category: sysdig-${{ matrix.service }}
        continue-on-error: true

      # ── Save SARIF as downloadable artifact ──────────────────────────────
      - name: Upload scan results artifact
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: sysdig-scan-${{ matrix.service }}-${{ github.sha }}
          path: ${{ github.workspace }}/sarif.json
          retention-days: 30

      # ── Post PR comment with scan summary ────────────────────────────────
      - name: Post PR comment — ${{ matrix.service }}
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const fs = require('fs');
            const service = '${{ matrix.service }}';
            const scanOutcome = '${{ steps.scan.outcome }}';
            const sha = context.sha.slice(0, 7);
            const imageTag = '${{ env.REGISTRY }}/${{ github.repository }}/' + service + ':sha-${{ github.sha }}';

            // Parse SARIF for a quick summary
            let critCount = 0, highCount = 0, medCount = 0, lowCount = 0, total = 0;
            try {
              const sarif = JSON.parse(fs.readFileSync('${{ github.workspace }}/sarif.json', 'utf8'));
              sarif.runs?.forEach(run => {
                run.results?.forEach(result => {
                  total++;
                  const sev = result.properties?.['problem.severity'] ||
                              result.level ||
                              result.properties?.severity || 'unknown';
                  if (/critical/i.test(sev))            critCount++;
                  else if (/error|high/i.test(sev))     highCount++;
                  else if (/warning|medium/i.test(sev)) medCount++;
                  else                                   lowCount++;
                });
              });
            } catch(e) { /* SARIF not parseable — show generic message */ }

            const statusIcon  = scanOutcome === 'success' ? '✅' : '❌';
            const statusLabel = scanOutcome === 'success' ? 'PASSED' : 'FAILED';

            const body = [
              `## ${statusIcon} Sysdig Scan — **${service}** — ${statusLabel}`,
              ``,
              `**Image:** \`${imageTag}\`  **Commit:** \`${sha}\``,
              ``,
              `| Severity | Count |`,
              `|----------|-------|`,
              `| 🔴 Critical | ${critCount} |`,
              `| 🟠 High     | ${highCount} |`,
              `| 🟡 Medium   | ${medCount} |`,
              `| 🔵 Low      | ${lowCount} |`,
              `| **Total**   | **${total}** |`,
              ``,
              `📋 **[View full report in GitHub Security tab →](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/security/code-scanning)**`,
              ``,
              `> Scan powered by [Sysdig Secure](https://sysdig.com/products/secure/) · [Docs](https://docs.sysdig.com/en/docs/sysdig-secure/scanning/)`,
            ].join('\n');

            // Find and update existing comment per service, or create new
            const { data: comments } = await github.rest.issues.listComments({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
            });
            const marker = `Sysdig Scan — **${service}**`;
            const existing = comments.find(c =>
              c.user.type === 'Bot' && c.body.includes(marker)
            );
            if (existing) {
              await github.rest.issues.updateComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                comment_id: existing.id,
                body,
              });
            } else {
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
                body,
              });
            }

      # ── Fail the workflow if the scan detected issues ────────────────────
      - name: Evaluate scan result
        if: steps.scan.outcome == 'failure'
        run: |
          echo "::error::Sysdig scan FAILED for ${{ matrix.service }} — vulnerabilities at or above '${{ env.FAIL_ON_SEVERITY }}' severity found."
          echo "::error::Review the Security tab or the uploaded SARIF artifact for details."
          exit 1

  # ════════════════════════════════════════════════════════════════════════════
  # JOB 2: PUSH — Push images to GHCR ONLY after clean scans (main branch)
  # ════════════════════════════════════════════════════════════════════════════
  push-images:
    name: "📦 Push to GHCR — ${{ matrix.service }}"
    runs-on: ubuntu-latest
    needs: build-scan
    if: |
      github.event_name == 'push' &&
      (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master')
    strategy:
      matrix:
        service: [vote, worker, result]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push ${{ matrix.service }}
        uses: docker/build-push-action@v6
        with:
          context: ./${{ matrix.service }}
          file: ./${{ matrix.service }}/Dockerfile
          push: true
          tags: |
            ${{ env.REGISTRY }}/${{ github.repository }}/${{ matrix.service }}:sha-${{ github.sha }}
            ${{ env.REGISTRY }}/${{ github.repository }}/${{ matrix.service }}:latest
          cache-from: type=gha,scope=${{ matrix.service }}
          cache-to: type=gha,scope=${{ matrix.service }},mode=max
